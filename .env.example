# Public contact details. Leave blank until MARKEX publishes them.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# JSON array, for example: [{"label":"Instagram","href":"https://instagram.com/example"}]
NEXT_PUBLIC_SOCIAL_LINKS=

# Payment provider. Never commit real secrets.
PAYMENT_GATEWAY_PROVIDER=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Optional CRM webhook for new leads.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# WhatsApp Business API. Unused until templates are configured.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=

# Protects GET /api/admin/overview
ADMIN_API_KEY=
